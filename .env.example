# Copia este fichero a .env y rellénalo. Nunca lo subas con valores reales.
# En el servidor, cada instancia tiene su propio fichero y systemd se lo pasa
# como EnvironmentFile; lo que venga del entorno gana sobre lo que ponga aquí.

# --- Credenciales (obligatorias: el servidor no arranca sin ellas) ---
GROQ_API_KEY=
GMAIL_APP_PASSWORD=

# --- Identidad de la instancia ---
COMPANY_NAME=Mi Empresa
BOT_NAME=Asistente
WIDGET_TITLE=Asistente comercial con IA
WIDGET_WELCOME=¡Hola! ¿En qué puedo ayudarte?
POWERED_BY_LABEL=Asistente IA
PRIVACY_URL=
BUSINESS_HOURS_MSG=

# --- Aviso de leads por email ---
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Webhook opcional (n8n u otro) que recibe el lead además del email
LEAD_WEBHOOK_URL=

# --- Ficheros de la instancia (rutas absolutas si viven fuera del repo) ---
PROMPT_FILE=
KEYWORDS_FILE=
# JSON plano {"clave": "texto"} para reescribir los textos del motor. Sin esto,
# el motor usa los suyos, escritos para un vertical industrial (pedidos, medidas).
TEXTS_FILE=
FRONTEND_DIR=
LOG_DIR=

# --- Comportamiento ---
# Puerto de la instancia. Lo usa la unidad de systemd de deploy/; con Docker
# manda el mapeo de docker-compose.yml.
PORT=8000
GROQ_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.7
MAX_TOKENS=500
# true: el bot responde libre y pide contacto cuando toca (clínicas, citas).
# false: máquina de fases —primero cualificar el pedido, luego el contacto.
SIMPLE_CHAT=false
# Deja que el bot dé precios. Con false, cualquier cifra en euros se sustituye.
ALLOW_PUBLIC_PRICES=false
# Palabras clave mínimas para dar un lead por bueno cuando no hay email ni teléfono
LEAD_MIN_KEYWORDS=1
LEAD_AUTO_SEND=true
# Panel de leads en /panel. Vacío = panel deshabilitado.
PANEL_TOKEN=
# Dominios permitidos para el widget. * en desarrollo, la lista real en producción.
ALLOWED_ORIGINS=*

# --- Canal WhatsApp (Meta Cloud API). Vacío = canal desactivado ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
